# Copie para .env e ajuste.
# Porta em que o app escuta (o nginx encaminha para ela)
PORT=3000
# 127.0.0.1 = só acessível pelo nginx na própria VPS (recomendado). Use 0.0.0.0 no Docker.
HOST=127.0.0.1
# true quando o site estiver em HTTPS (obrigatório em produção)
COOKIE_SECURE=true
# Segredo das sessões (mínimo 32 caracteres). Gere com: openssl rand -hex 32
# Se ficar vazio, o app cria um e guarda em data/.segredo
SESSION_SECRET=
# Pasta do banco e das fotos
DATA_DIR=./data
# Mercado Pago: Pix com confirmação automática no link do cliente.
# Access Token em mercadopago.com.br/developers → Suas integrações → (sua aplicação) → Credenciais.
# Comece com o de teste (TEST-...) e depois troque pelo de produção (APP_USR-...). Vazio = Pix pela chave, confirmação manual.
MP_ACCESS_TOKEN=
# Endereço público do site. Ex.: https://3d.seudominio.com.br
# No painel do Mercado Pago (Configuração de webhooks), cadastre <PUBLIC_URL>/api/mp/webhook com o evento "Order".
PUBLIC_URL=
# Public Key do Mercado Pago (mesma tela das credenciais). Com ela, o link do cliente oferece também
# cartão de crédito em até 12x (juros por conta do cliente). Vazio = só Pix.
MP_PUBLIC_KEY=
# Assinatura secreta dos webhooks (Mercado Pago → Configuração de webhooks). Com ela, aviso sem a
# assinatura certa é recusado (401). Vazio = aceita o aviso e confere a order direto na API.
MP_WEBHOOK_SECRET=

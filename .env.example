# Copie para .env e ajuste.
# Porta em que o app escuta (o nginx encaminha para ela)
PORT=3000
# 127.0.0.1 = só acessível pelo nginx na própria VPS (recomendado). Use 0.0.0.0 no Docker.
HOST=127.0.0.1
# true quando o site estiver em HTTPS (obrigatório em produção)
COOKIE_SECURE=true
# Segredo das sessões (mínimo 32 caracteres). Gere com: openssl rand -hex 32
# Se ficar vazio, o app cria um e guarda em data/.segredo
SESSION_SECRET=
# Pasta do banco e das fotos
DATA_DIR=./data
